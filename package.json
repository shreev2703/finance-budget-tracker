{
  "name": "finance-budget-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "LedgerLogic: a budget tracker for college students",
  "workspaces": [
    "packages/backend",
    "packages/frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "seed": "npm run seed -w backend",
    "test": "npm test -w backend",
    "lint": "npm run lint -w backend",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shreev2703/finance-budget-tracker.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/shreev2703/finance-budget-tracker/issues"
  },
  "homepage": "https://github.com/shreev2703/finance-budget-tracker#readme",
  "devDependencies": {
    "concurrently": "^9.0.0",
    "prettier": "^3.9.8"
  }
}

# Copy to packages/backend/.env (never commit the real one).
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=replace-with-a-long-random-string
# Supabase Dashboard → Project Settings → Database → Connection string
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres
# Optional: DB_SSL=disable and DB_POOL_MAX=10
# Optional, tests only: a throwaway Postgres for `npm test`. Leave unset to use in-memory PGlite. Never the app's database.
# TEST_DATABASE_URL=postgresql://user:pass@localhost:5432/ledger_test
# Optional: bank connections through Plaid (#94). Leave unset and the Connect bank button stays hidden.
# Free sandbox keys: dashboard.plaid.com → Developers → Keys. Sandbox login: user_good / pass_good.
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# Optional: its own key for encrypting stored bank tokens (defaults to one derived from TOKEN_SECRET).
# PLAID_TOKEN_KEY=
